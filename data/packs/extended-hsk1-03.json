{"id":"extended-hsk1-03","label":"Extended HSK 1","cards":[{"id":161,"zh":"孩子","py":"háizi","en":"child","topic":"Extended HSK 1","examples":[["那个孩子在玩。","Nàge háizi zài wán.","That child is playing."],["那两个孩子正在公园里玩。","Nà liǎng ge háizi zhèngzài gōngyuán lǐ wán.","Those two children are playing in the park."]]},{"id":162,"zh":"儿子","py":"érzi","en":"son","topic":"Extended HSK 1","examples":[["他是我的儿子。","Tā shì wǒ de érzi.","He is my son."],["我的儿子今年六岁，喜欢画画。","Wǒ de érzi jīnnián liù suì, xǐhuan huàhuà.","My son is six years old and likes drawing."]]},{"id":163,"zh":"女儿","py":"nǚ’ér","en":"daughter","topic":"Extended HSK 1","examples":[["她是我的女儿。","Tā shì wǒ de nǚ'ér.","She is my daughter."],["她的女儿每天自己走路去学校。","Tā de nǚ'ér měi tiān zìjǐ zǒulù qù xuéxiào.","Her daughter walks to school by herself every day."]]},{"id":164,"zh":"男","py":"nán","en":"male","topic":"Extended HSK 1","examples":[["他是男学生。","Tā shì nán xuésheng.","He is a male student."],["这是男老师。","Zhè shì nán lǎoshī.","This is a male teacher."]]},{"id":165,"zh":"女","py":"nǚ","en":"female","topic":"Extended HSK 1","examples":[["她是女老师。","Tā shì nǚ lǎoshī.","She is a female teacher."],["这是女学生。","Zhè shì nǚ xuésheng.","This is a female student."]]},{"id":166,"zh":"男朋友","py":"nánpéngyou","en":"boyfriend","topic":"Extended HSK 1","examples":[["他是我的男朋友。","Tā shì wǒ de nánpéngyou.","He is my boyfriend."],["她的男朋友在医院工作。","Tā de nánpéngyou zài yīyuàn gōngzuò.","Her boyfriend works at a hospital."]]},{"id":167,"zh":"女朋友","py":"nǚpéngyou","en":"girlfriend","topic":"Extended HSK 1","examples":[["她是我的女朋友。","Tā shì wǒ de nǚpéngyou.","She is my girlfriend."],["我哥哥和他的女朋友明天来吃饭。","Wǒ gēge hé tā de nǚpéngyou míngtiān lái chīfàn.","My older brother and his girlfriend are coming for dinner tomorrow."]]},{"id":168,"zh":"小朋友","py":"xiǎopéngyou","en":"young child","topic":"Extended HSK 1","examples":[["小朋友在公园玩。","Xiǎopéngyou zài gōngyuán wán.","The child is playing in the park."],["两个小朋友在树下面一起看书。","Liǎng ge xiǎopéngyou zài shù xiàmiàn yìqǐ kàn shū.","Two children are reading together under a tree."]]},{"id":169,"zh":"漂亮","py":"piàoliang","en":"pretty","topic":"Extended HSK 1","examples":[["这朵花很漂亮。","Zhè duǒ huā hěn piàoliang.","This flower is beautiful."],["公园里的花很漂亮，我想拍照。","Gōngyuán lǐ de huā hěn piàoliang, wǒ xiǎng pāizhào.","The flowers in the park are beautiful, and I want to take pictures."]]},{"id":170,"zh":"好看","py":"hǎokàn","en":"good-looking","topic":"Extended HSK 1","examples":[["这件衣服很好看。","Zhè jiàn yīfu hěn hǎokàn.","This item of clothing looks nice."],["你今天穿的这件衣服真好看。","Nǐ jīntiān chuān de zhè jiàn yīfu zhēn hǎokàn.","The clothes you're wearing today look really nice."]]},{"id":171,"zh":"忙","py":"máng","en":"busy","topic":"Extended HSK 1","examples":[["我今天很忙。","Wǒ jīntiān hěn máng.","I'm very busy today."],["妈妈今天很忙，不能和我们一起去。","Māma jīntiān hěn máng, bù néng hé wǒmen yìqǐ qù.","Mom is busy today and can't come with us."]]},{"id":172,"zh":"真","py":"zhēn","en":"really","topic":"Extended HSK 1","examples":[["你真好！","Nǐ zhēn hǎo!","You're really kind!"],["这本书真好看。","Zhè běn shū zhēn hǎokàn.","This book is really good."]]},{"id":173,"zh":"非常","py":"fēicháng","en":"extremely","topic":"Extended HSK 1","examples":[["今天非常热。","Jīntiān fēicháng rè.","It's extremely hot today."],["我非常喜欢中文。","Wǒ fēicháng xǐhuan Zhōngwén.","I really like Chinese."]]},{"id":174,"zh":"太","py":"tài","en":"too very","topic":"Extended HSK 1","examples":[["太好了！","Tài hǎo le!","That's great!"],["这个太贵了，我们去别的店看看吧。","Zhège tài guì le, wǒmen qù bié de diàn kànkan ba.","This is too expensive; let’s look in another shop."]]},{"id":175,"zh":"只","py":"zhī","en":"animal measure word","topic":"Extended HSK 1","examples":[["我有一只猫。","Wǒ yǒu yì zhī māo.","I have a cat."],["这里有两只狗。","Zhèli yǒu liǎng zhī gǒu.","There are two dogs here."]]},{"id":176,"zh":"它们","py":"tāmen","en":"they (things)","topic":"Extended HSK 1","examples":[["它们都是猫。","Tāmen dōu shì māo.","They are all cats."],["它们在桌子下面。","Tāmen zài zhuōzi xiàmiàn.","They are under the table."]]},{"id":177,"zh":"爱","py":"ài","en":"to love","topic":"Extended HSK 1","examples":[["我爱妈妈。","Wǒ ài māma.","I love my mom."],["我爱我的家人。","Wǒ ài wǒ de jiārén.","I love my family."]]},{"id":178,"zh":"天","py":"tiān","en":"day","topic":"Extended HSK 1","examples":[["今天天气很好。","Jīntiān tiānqì hěn hǎo.","The weather is good today."],["我每天学习中文。","Wǒ měi tiān xuéxí Zhōngwén.","I study Chinese every day."]]},{"id":179,"zh":"月","py":"yuè","en":"month","topic":"Extended HSK 1","examples":[["这个月我很忙。","Zhège yuè wǒ hěn máng.","I'm busy this month."],["下个月见！","Xià ge yuè jiàn!","See you next month!"]]},{"id":180,"zh":"号","py":"hào","en":"day of month","topic":"Extended HSK 1","examples":[["今天是十月十号。","Jīntiān shì shí yuè shí hào.","Today is October tenth."],["今天是十月十号，明天是十一号。","Jīntiān shì shí yuè shí hào, míngtiān shì shíyī hào.","Today is October 10; tomorrow is the 11th."]]}]}
