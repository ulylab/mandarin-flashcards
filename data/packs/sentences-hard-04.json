    {
      "id": "sentence-hard-017",
      "type": "sentence",
      "difficulty": "hard",
      "sourcePack": "extended-hsk1-11",
      "topic": "Sentence practice",
      "zh": "我昨天生病了，今天去医院看病，医生说我要多休息，不要去上班。",
      "py": "Wǒ zuótiān shēngbìng le, jīntiān qù yīyuàn kànbìng, yīshēng shuō wǒ yào duō xiūxi, búyào qù shàngbān.",
      "en": "I got sick yesterday and went to the hospital today. The doctor said I need more rest and shouldn't go to work.",
      "breakdown": [
        {
          "zh": "我",
          "py": "wǒ",
          "en": "I / me"
        },
        {
