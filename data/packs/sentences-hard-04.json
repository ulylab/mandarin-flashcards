          "en": "doctor"
        },
        {
          "zh": "说",
          "py": "shuō",
          "en": "to speak / say"
        },
        {
          "zh": "我",
          "py": "wǒ",
          "en": "I / me"
        },
        {
          "zh": "要",
          "py": "yào",
          "en": "need / want"
        },
        {
          "zh": "多",
          "py": "duō",
          "en": "many"
